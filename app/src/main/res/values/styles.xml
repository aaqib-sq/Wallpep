<resources>
    <!-- Obsidian Pulse: near-black OLED surfaces, one electric-blue accent, no gold. -->
    <style name="Theme.Wallpep" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/pulse_blue</item>
        <item name="android:colorPrimary">@color/pulse_blue</item>
        <item name="android:colorPrimaryDark">@color/obsidian_background</item>
        <item name="android:colorBackground">@color/obsidian_background</item>
        <item name="android:textColorPrimary">@color/obsidian_text</item>
        <item name="android:textColorSecondary">@color/obsidian_muted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/obsidian_background</item>
        <item name="android:statusBarColor">@color/obsidian_background</item>
        <item name="android:navigationBarColor">@color/obsidian_surface</item>
    </style>
</resources>
